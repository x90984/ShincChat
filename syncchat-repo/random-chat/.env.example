# Copy this file to .env for local development. On Render, set these as
# Environment Variables in the service's dashboard instead — .env is not
# read there.

# Render sets this automatically; only needed locally if you want a
# non-default port.
PORT=3000

# Optional — enables "Continue with Google". If unset, the app just hides
# the Google sign-in button and email/mobile signup still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the URL Render gives you (or your custom domain), e.g.
# https://your-app.onrender.com — used to build the OAuth redirect URI.
OAUTH_BASE_URL=

# Required — Supabase Postgres, POOLED ("Transaction") connection string,
# not the direct one. Project Settings -> Database -> Connection string ->
# Transaction pooler (port 6543).
DATABASE_URL=

# Required — Upstash Redis REST credentials (from your Upstash dashboard,
# NOT the "redis://" TCP URL — the REST URL/token pair).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Scale-out (optional but required for MULTIPLE instances) ------------
# Standard Redis TCP URL — enables cluster mode: shared matchmaking queue,
# sessions, presence, and the Socket.IO Redis adapter so users on different
# instances can match and chat with each other. Without it, the app runs in
# single-instance mode (default, fine for the free tier).
#
# Any Redis >= 5 works:
#   - Upstash: same dashboard page, copy the rediss:// endpoint
#     (e.g. rediss://default:<token>@<host>.upstash.io:6379)
#   - self-hosted on a free VM (Oracle Always Free etc.): redis://<ip>:6379
#     (bind with a strong password: redis://:<password>@<ip>:6379)
#   - Redis Cloud free 30MB: rediss://default:<pass>@<host>:<port>
#REDIS_URL=

# Session token lifetime in seconds (default 7 days).
#SESSION_TTL_SEC=604800

# ---- WebRTC relay (optional) ---------------------------------------------
# P2P video/voice is FREE for you (traffic goes user<->user), but ~5-20% of
# users sit behind NATs where P2P fails — those calls need a TURN relay.
# Free options: Metered OpenRelay (20 GB/mo free), or coturn on a free VM.
# Comma-separated URLs; all given to the browser as one iceServer entry.
#STUN_URLS=stun:stun.l.google.com:19302
#TURN_URLS=turn:staticauth.openrelay.metered.ca:80,turn:staticauth.openrelay.metered.ca:443
#TURN_USERNAME=openrelayproject
#TURN_CREDENTIAL=openrelayproject
